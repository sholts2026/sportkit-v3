<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>SportKit Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{--g:#00ff41;--bg:#0a0a0a;--card:#161616;}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:#fff;font-family:'DM Sans',sans-serif;min-height:100vh;}
nav{display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem;border-bottom:1px solid rgba(255,255,255,.08);background:#111;}
.logo{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;letter-spacing:2px;color:var(--g);}
.logo span{color:#fff;}
.logo small{font-size:.7rem;color:#666;letter-spacing:1px;margin-right:8px;}
.navbtn{background:#222;color:#aaa;border:1px solid #333;padding:.5rem 1rem;font-weight:600;cursor:pointer;border-radius:5px;font-family:inherit;font-size:.78rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
.navbtn:hover{border-color:var(--g);color:var(--g);}

.container{max-width:900px;margin:0 auto;padding:2rem;}

/* Login */
.login{max-width:400px;margin:5rem auto;background:#111;border:1px solid #2a2a2a;border-radius:12px;padding:2rem;}
.login h2{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;text-align:center;margin-bottom:.5rem;letter-spacing:1px;}
.login p{text-align:center;color:#666;font-size:.85rem;margin-bottom:1.5rem;}
.login input{width:100%;background:#1e1e1e;border:1px solid #2a2a2a;color:#fff;padding:14px;font-family:inherit;font-size:1rem;border-radius:6px;outline:none;text-align:center;letter-spacing:2px;}
.login input:focus{border-color:var(--g);}
.login button{width:100%;background:var(--g);color:#000;border:none;padding:14px;font-weight:700;border-radius:6px;cursor:pointer;font-family:inherit;font-size:.9rem;margin-top:1rem;letter-spacing:1px;}
.login .err{color:#ff4757;font-size:.78rem;text-align:center;margin-top:.8rem;display:none;}
.login .err.show{display:block;}

/* Tabs */
.tabs{display:flex;gap:4px;margin-bottom:1.5rem;border-bottom:1px solid #222;}
.tab{background:none;border:none;color:#666;padding:.9rem 1.5rem;cursor:pointer;font-family:inherit;font-size:.88rem;font-weight:600;border-bottom:2px solid transparent;}
.tab.active{color:var(--g);border-bottom-color:var(--g);}
.tab:hover{color:#fff;}

.tabpane{display:none;}
.tabpane.active{display:block;}

/* Forms */
.section{background:#111;border:1px solid #222;border-radius:10px;padding:1.5rem;margin-bottom:1.2rem;}
.section h3{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;margin-bottom:1rem;letter-spacing:1px;color:var(--g);}
.section p.hint{color:#666;font-size:.78rem;margin-bottom:1rem;line-height:1.5;}
.field{margin-bottom:1rem;}
.field label{display:block;font-size:.78rem;color:#888;margin-bottom:.4rem;font-weight:600;}
.field input,.field textarea,.field select{width:100%;background:#1a1a1a;border:1px solid #2a2a2a;color:#fff;padding:10px 12px;font-family:inherit;font-size:.88rem;border-radius:5px;outline:none;}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--g);}
.field textarea{min-height:60px;resize:vertical;font-family:inherit;}
.field .help{font-size:.7rem;color:#555;margin-top:.3rem;}

.row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}
@media(max-width:600px){.row{grid-template-columns:1fr;}}

.btn{background:var(--g);color:#000;border:none;padding:11px 22px;font-weight:700;border-radius:5px;cursor:pointer;font-family:inherit;font-size:.85rem;letter-spacing:.5px;}
.btn:hover{box-shadow:0 4px 16px rgba(0,255,65,.3);}
.btn.secondary{background:#222;color:#aaa;border:1px solid #333;}
.btn.secondary:hover{background:#333;color:#fff;box-shadow:none;}
.btn.danger{background:#ff4757;color:#fff;}

/* Image preview */
.imgprev{width:100px;height:100px;background:#1a1a1a;border:1px dashed #333;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#444;font-size:2rem;cursor:pointer;overflow:hidden;}
.imgprev img{width:100%;height:100%;object-fit:cover;}
input[type=file]{display:none;}

/* Items list */
.itemlist{display:flex;flex-direction:column;gap:.8rem;}
.item{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:8px;padding:.8rem;display:flex;gap:1rem;align-items:center;}
.item img{width:60px;height:60px;object-fit:cover;border-radius:5px;background:#222;}
.iteminfo{flex:1;min-width:0;}
.iteminfo .iname{font-size:.88rem;font-weight:600;margin-bottom:3px;}
.iteminfo .imeta{font-size:.7rem;color:#666;}
.itemactions{display:flex;gap:6px;}
.iconbtn{background:#222;border:1px solid #333;color:#888;width:32px;height:32px;border-radius:5px;cursor:pointer;font-size:.85rem;}
.iconbtn:hover{color:#fff;border-color:#555;}
.iconbtn.del:hover{color:#ff4757;border-color:#ff4757;}

.empty{text-align:center;padding:2rem;color:#444;font-size:.85rem;}

/* Toast */
.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(100px);background:var(--g);color:#000;padding:11px 20px;border-radius:6px;font-weight:700;transition:.3s;z-index:1000;font-size:.82rem;pointer-events:none;}
.toast.show{transform:translateX(-50%) translateY(0);}

/* Size pills */
.sizepicker{display:flex;gap:5px;flex-wrap:wrap;}
.sizepill{padding:5px 12px;background:#1a1a1a;border:1px solid #2a2a2a;color:#888;border-radius:4px;cursor:pointer;font-size:.75rem;font-family:inherit;}
.sizepill.on{background:var(--g);color:#000;border-color:var(--g);font-weight:700;}

/* Export/Import */
.bigtext{width:100%;min-height:120px;background:#0a0a0a;border:1px solid #2a2a2a;color:#aaa;padding:10px;font-family:monospace;font-size:.75rem;border-radius:5px;outline:none;resize:vertical;}
</style>
</head>
<body>
<nav>
  <div class="logo">SPORT<span>KIT</span> <small>ADMIN</small></div>
  <div>
    <a href="/" class="navbtn">← לאתר</a>
    <button class="navbtn" id="logoutbtn" onclick="logout()" style="display:none;">יציאה</button>
  </div>
</nav>

<!-- LOGIN -->
<div class="login" id="login">
  <h2>כניסה לפאנל ניהול</h2>
  <p>הזן סיסמה כדי להמשיך</p>
  <input type="password" id="pw" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()" autofocus/>
  <button onclick="doLogin()">כניסה</button>
  <div class="err" id="loginerr">סיסמה שגויה</div>
</div>

<!-- ADMIN -->
<div class="container" id="admin" style="display:none;">
  <div class="tabs">
    <button class="tab active" onclick="showTab('items',this)">📦 חולצות מותאמות</button>
    <button class="tab" onclick="showTab('config',this)">⚙️ הגדרות אתר</button>
    <button class="tab" onclick="showTab('backup',this)">💾 גיבוי</button>
  </div>

  <!-- Custom items -->
  <div class="tabpane active" id="tab-items">
    <div class="section">
      <h3>הוסף חולצה חדשה</h3>
      <p class="hint">חולצות שתוסיף כאן יופיעו בראש הקטלוג עם תג "חדש". מצוין לפריטים שאינם בקטלוג Yupoo.</p>

      <div class="field">
        <label>תמונה</label>
        <div style="display:flex;gap:1rem;align-items:flex-start;">
          <label class="imgprev" id="imgprev">+
            <input type="file" id="imgfile" accept="image/*" onchange="handleImage(this)"/>
          </label>
          <div style="flex:1;">
            <input type="text" id="imgurl" placeholder="או הדבק URL של תמונה" oninput="setImageFromUrl(this.value)"/>
            <div class="help" style="margin-top:.4rem;">העלה תמונה מהמחשב או הדבק לינק. מומלץ עד 500KB.</div>
          </div>
        </div>
      </div>

      <div class="field">
        <label>שם החולצה</label>
        <input type="text" id="newname" placeholder="לדוגמה: Real Madrid 25/26 Special Edition"/>
      </div>

      <div class="row">
        <div class="field">
          <label>קטגוריה</label>
          <input type="text" id="newcat" placeholder="לדוגמה: ריאל מדריד"/>
        </div>
        <div class="field">
          <label>הערה (אופציונלי)</label>
          <input type="text" id="newnote" placeholder="פרטים נוספים..."/>
        </div>
      </div>

      <div class="field">
        <label>מידות זמינות</label>
        <div class="sizepicker" id="sizepicker">
          <span class="sizepill on" data-s="S">S</span>
          <span class="sizepill on" data-s="M">M</span>
          <span class="sizepill on" data-s="L">L</span>
          <span class="sizepill on" data-s="XL">XL</span>
          <span class="sizepill on" data-s="2XL">2XL</span>
          <span class="sizepill" data-s="3XL">3XL</span>
          <span class="sizepill" data-s="4XL">4XL</span>
        </div>
      </div>

      <button class="btn" onclick="addItem()">+ הוסף חולצה</button>
    </div>

    <div class="section">
      <h3>חולצות קיימות (<span id="itemcount">0</span>)</h3>
      <div class="itemlist" id="itemlist"></div>
    </div>
  </div>

  <!-- Config -->
  <div class="tabpane" id="tab-config">
    <div class="section">
      <h3>הגדרות כלליות</h3>

      <div class="field">
        <label>מספר וואטסאפ</label>
        <input type="text" id="cf-wa" placeholder="972501234567"/>
        <div class="help">פורמט: קוד מדינה ואז המספר ללא 0 בהתחלה. דוגמה: 972521234567</div>
      </div>

      <div class="field">
        <label>מחיר הדפסת שם ומספר (₪)</label>
        <input type="number" id="cf-pp" min="0" max="999"/>
      </div>

      <div class="field">
        <label>כותרת ראשית (אנגלית)</label>
        <input type="text" id="cf-h1" placeholder="CHOOSE YOUR GEAR"/>
        <div class="help">המילה GEAR תהפוך לירוקה אוטומטית.</div>
      </div>

      <div class="field">
        <label>כותרת משנה</label>
        <input type="text" id="cf-h2" placeholder="חולצות מכל הליגות"/>
      </div>

      <button class="btn" onclick="saveConfig()">💾 שמור הגדרות</button>
    </div>

    <div class="section">
      <h3>סיסמת אדמין</h3>
      <p class="hint">שנה את הסיסמה לפאנל הניהול. הסיסמה נשמרת רק במחשב הזה.</p>
      <div class="field">
        <label>סיסמה חדשה</label>
        <input type="password" id="cf-pw" placeholder="הזן סיסמה חדשה"/>
      </div>
      <button class="btn" onclick="changePassword()">🔒 עדכן סיסמה</button>
    </div>
  </div>

  <!-- Backup -->
  <div class="tabpane" id="tab-backup">
    <div class="section">
      <h3>📤 ייצוא נתונים</h3>
      <p class="hint">שמור את כל החולצות וההגדרות שלך כקובץ JSON. שמור אותו במקום בטוח כגיבוי או כדי להעביר למכשיר אחר.</p>
      <button class="btn" onclick="exportData()">💾 ייצא הכל לקובץ</button>
    </div>

    <div class="section">
      <h3>📥 ייבוא נתונים</h3>
      <p class="hint">ייבא קובץ גיבוי שיצרת קודם. <strong style="color:#ff4757;">זה יחליף את כל הנתונים הקיימים!</strong></p>
      <input type="file" id="importfile" accept=".json" style="display:block;margin-bottom:1rem;color:#888;"/>
      <button class="btn danger" onclick="importData()">⚠️ ייבא וחליף הכל</button>
    </div>

    <div class="section">
      <h3>🗑 איפוס</h3>
      <p class="hint">מחק את כל החולצות המותאמות וחזור להגדרות ברירת מחדל.</p>
      <button class="btn danger" onclick="resetAll()">איפוס מלא</button>
    </div>
  </div>
</div>

<div class="toast" id="tst"></div>

<script>
// ----- Config -----
const DEFAULT_CONFIG = {
  whatsapp: "972501234567",
  printPrice: 10,
  heroTitle: "CHOOSE YOUR GEAR",
  heroSubtitle: "חולצות מכל הליגות"
};
const DEFAULT_PASSWORD = "sportkit2026";

// ----- Storage helpers -----
function getConfig(){
  try { return { ...DEFAULT_CONFIG, ...JSON.parse(localStorage.getItem('sportkit_config')||'{}') }; }
  catch { return { ...DEFAULT_CONFIG }; }
}
function setConfig(c){ localStorage.setItem('sportkit_config', JSON.stringify(c)); }
function getItems(){
  try { return JSON.parse(localStorage.getItem('sportkit_items')||'[]'); }
  catch { return []; }
}
function setItems(items){ localStorage.setItem('sportkit_items', JSON.stringify(items)); }
function getPassword(){ return localStorage.getItem('sportkit_pw') || DEFAULT_PASSWORD; }
function setPassword(p){ localStorage.setItem('sportkit_pw', p); }

// ----- Login -----
function doLogin(){
  const pw = document.getElementById('pw').value;
  if (pw === getPassword()) {
    sessionStorage.setItem('sportkit_admin', '1');
    showAdmin();
  } else {
    document.getElementById('loginerr').classList.add('show');
    document.getElementById('pw').value='';
    setTimeout(()=>document.getElementById('loginerr').classList.remove('show'), 2500);
  }
}
function logout(){
  sessionStorage.removeItem('sportkit_admin');
  location.reload();
}
function showAdmin(){
  document.getElementById('login').style.display='none';
  document.getElementById('admin').style.display='block';
  document.getElementById('logoutbtn').style.display='inline-flex';
  loadConfigUI();
  renderItems();
}

if (sessionStorage.getItem('sportkit_admin') === '1') showAdmin();

// ----- Tabs -----
function showTab(name, btn){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tabpane').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
}

// ----- Image handling -----
let currentImage = null;
function handleImage(input){
  const file = input.files[0];
  if (!file) return;
  if (file.size > 800*1024) {
    toast('❗ התמונה גדולה מדי (מקסימום 800KB)');
    return;
  }
  const reader = new FileReader();
  reader.onload = e => {
    currentImage = e.target.result;
    const prev = document.getElementById('imgprev');
    prev.innerHTML = '<img src="'+currentImage+'"/>';
    document.getElementById('imgurl').value='';
  };
  reader.readAsDataURL(file);
}
function setImageFromUrl(url){
  if (!url || !url.match(/^https?:\/\//)) {
    if (!url) {
      currentImage = null;
      document.getElementById('imgprev').innerHTML='+';
    }
    return;
  }
  currentImage = url;
  document.getElementById('imgprev').innerHTML = '<img src="'+url+'" onerror="this.parentNode.innerHTML=\'❌\'"/>';
}

// ----- Size picker -----
document.addEventListener('click', e => {
  if (e.target.classList.contains('sizepill')) {
    e.target.classList.toggle('on');
  }
});
function getSelectedSizes(){
  return Array.from(document.querySelectorAll('.sizepill.on')).map(p=>p.dataset.s);
}

// ----- Add item -----
function addItem(){
  const name = document.getElementById('newname').value.trim();
  const cat = document.getElementById('newcat').value.trim() || 'מותאם אישית';
  const note = document.getElementById('newnote').value.trim();
  const sizes = getSelectedSizes();

  if (!currentImage) { toast('❗ חסרה תמונה'); return; }
  if (!name) { toast('❗ חסר שם החולצה'); return; }
  if (sizes.length === 0) { toast('❗ בחר לפחות מידה אחת'); return; }

  const items = getItems();
  items.unshift({
    id: 'c_' + Date.now(),
    name, category: cat, note, sizes,
    img: currentImage,
    addedAt: Date.now()
  });
  setItems(items);

  // Reset form
  document.getElementById('newname').value='';
  document.getElementById('newcat').value='';
  document.getElementById('newnote').value='';
  document.getElementById('imgurl').value='';
  document.getElementById('imgfile').value='';
  document.getElementById('imgprev').innerHTML='+';
  currentImage = null;

  renderItems();
  toast('✅ '+name+' נוסף');
}

function deleteItem(id){
  if (!confirm('למחוק את החולצה הזו?')) return;
  setItems(getItems().filter(i => i.id !== id));
  renderItems();
  toast('🗑 נמחק');
}

function renderItems(){
  const items = getItems();
  document.getElementById('itemcount').textContent = items.length;
  const el = document.getElementById('itemlist');
  if (items.length === 0) {
    el.innerHTML = '<div class="empty">אין עדיין חולצות מותאמות. הוסף את הראשונה למעלה ⬆️</div>';
    return;
  }
  el.innerHTML = items.map(i =>
    '<div class="item">'
    +'<img src="'+i.img+'" onerror="this.style.opacity=0.2"/>'
    +'<div class="iteminfo"><div class="iname">'+escapeHtml(i.name)+'</div>'
    +'<div class="imeta">'+escapeHtml(i.category)+' • '+i.sizes.join(', ')+(i.note?' • '+escapeHtml(i.note):'')+'</div></div>'
    +'<div class="itemactions"><button class="iconbtn del" onclick="deleteItem(\''+i.id+'\')" title="מחק">🗑</button></div>'
    +'</div>'
  ).join('');
}

function escapeHtml(s){return(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

// ----- Config -----
function loadConfigUI(){
  const c = getConfig();
  document.getElementById('cf-wa').value = c.whatsapp;
  document.getElementById('cf-pp').value = c.printPrice;
  document.getElementById('cf-h1').value = c.heroTitle;
  document.getElementById('cf-h2').value = c.heroSubtitle;
}
function saveConfig(){
  const wa = document.getElementById('cf-wa').value.replace(/\D/g,'');
  if (!wa.match(/^\d{8,15}$/)) { toast('❗ מספר וואטסאפ לא תקין'); return; }
  const pp = parseInt(document.getElementById('cf-pp').value) || 0;
  const h1 = document.getElementById('cf-h1').value.trim() || DEFAULT_CONFIG.heroTitle;
  const h2 = document.getElementById('cf-h2').value.trim() || DEFAULT_CONFIG.heroSubtitle;
  setConfig({ whatsapp: wa, printPrice: pp, heroTitle: h1, heroSubtitle: h2 });
  toast('✅ הגדרות נשמרו');
}
function changePassword(){
  const np = document.getElementById('cf-pw').value.trim();
  if (np.length < 4) { toast('❗ סיסמה חייבת להיות לפחות 4 תווים'); return; }
  setPassword(np);
  document.getElementById('cf-pw').value='';
  toast('✅ הסיסמה עודכנה');
}

// ----- Backup -----
function exportData(){
  const data = {
    version: 1,
    exportedAt: new Date().toISOString(),
    config: getConfig(),
    items: getItems()
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'sportkit-backup-' + new Date().toISOString().split('T')[0] + '.json';
  a.click();
  URL.revokeObjectURL(url);
  toast('💾 הקובץ הורד');
}
function importData(){
  const file = document.getElementById('importfile').files[0];
  if (!file) { toast('❗ בחר קובץ קודם'); return; }
  if (!confirm('זה יחליף את כל הנתונים הקיימים. להמשיך?')) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if (data.config) setConfig(data.config);
      if (data.items) setItems(data.items);
      loadConfigUI();
      renderItems();
      toast('✅ הנתונים יובאו ('+( data.items?.length||0 )+' פריטים)');
    } catch (err) {
      toast('❗ קובץ לא תקין');
    }
  };
  reader.readAsText(file);
}
function resetAll(){
  if (!confirm('למחוק את כל החולצות וההגדרות? פעולה זו אינה הפיכה.')) return;
  if (!confirm('בטוח? זה ימחק הכל.')) return;
  localStorage.removeItem('sportkit_config');
  localStorage.removeItem('sportkit_items');
  loadConfigUI();
  renderItems();
  toast('🗑 הכל נמחק');
}

function toast(msg){
  const t=document.getElementById('tst');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2800);
}
</script>
</body>
</html>
